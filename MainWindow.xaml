<Window x:Class="ClipQueue.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipQueue"
        Width="372" Height="500"
        MinWidth="260" MinHeight="180"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        Icon="pack://application:,,,/ClipQueue.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent" Margin="1,4,1,4">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="#38FFFFFF" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderIconBtn" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A1A7B8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#20FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#30FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseIconBtn" TargetType="{x:Type Button}" BasedOn="{StaticResource HeaderIconBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D93838"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardActionBtn" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="#18FFFFFF"/>
            <Setter Property="Foreground" Value="#C8CEDE"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#34FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FooterBtn" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#18FFFFFF"/>
            <Setter Property="Foreground" Value="#E2E6F0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#28FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#38FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentBtn" TargetType="{x:Type Button}" BasedOn="{StaticResource FooterBtn}">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CleanListItem" TargetType="{x:Type ListBoxItem}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EdgeResizeThumb" TargetType="{x:Type Thumb}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="MainShell"
                Margin="14"
                CornerRadius="14"
                Background="#EE141622"
                BorderBrush="#28FFFFFF"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.58" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Custom Draggable Title Bar -->
                <Border x:Name="TitleBar"
                        Grid.Row="0"
                        Background="#10FFFFFF"
                        CornerRadius="14,14,0,0"
                        BorderBrush="#16FFFFFF"
                        BorderThickness="0,0,0,1"
                        Padding="12,0,8,0"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="CaptureDot" Grid.Column="0" Width="8" Height="8" Fill="#22C55E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtTitle" Grid.Column="1" Text="ClipQueue" Foreground="#F3F5FA"
                                       FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border x:Name="CountBadge" Grid.Column="2" Background="#1EFFFFFF" CornerRadius="6" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtCount" Text="0" Foreground="#B4BCCF" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock x:Name="TxtMiniPreview" Grid.Column="3" Text="" Foreground="#EEF1F8"
                                       FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center"
                                       Margin="0,0,4,0" TextTrimming="CharacterEllipsis"
                                       Visibility="Collapsed"/>
                        </Grid>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnPin" Style="{StaticResource HeaderIconBtn}" ToolTip="Always on Top: ON" Margin="0,0,2,0" Click="BtnPin_Click">
                                <Path x:Name="IconPin" Data="M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22H12.8V16H18V14L16,12Z"
                                      Fill="#60A5FA" Stretch="Uniform" Width="13" Height="13"/>
                            </Button>

                            <Button x:Name="BtnCapture" Style="{StaticResource HeaderIconBtn}" ToolTip="Auto-Capture: ON" Margin="0,0,2,0" Click="BtnCapture_Click">
                                <Path x:Name="IconCapture" Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7Z"
                                      Fill="#22C55E" Stretch="Uniform" Width="13" Height="13"/>
                            </Button>

                            <Button x:Name="BtnCollapse" Style="{StaticResource HeaderIconBtn}" ToolTip="Collapse to Mini Pill" Margin="0,0,2,0" Click="BtnCollapse_Click">
                                <Path x:Name="IconCollapse" Data="M7.41,15.41L12,10.83L16.59,15.41L18,14L12,8L6,14L7.41,15.41Z"
                                      Fill="#A1A7B8" Stretch="Uniform" Width="12" Height="12"/>
                            </Button>

                            <Button x:Name="BtnMinimize" Style="{StaticResource HeaderIconBtn}" ToolTip="Minimize" Margin="0,0,2,0" Click="BtnMinimize_Click">
                                <Path Data="M20,14H4V10H20" Fill="#A1A7B8" Stretch="Uniform" Width="10" Height="10"/>
                            </Button>

                            <Button x:Name="BtnClose" Style="{StaticResource CloseIconBtn}" ToolTip="Close" Click="BtnClose_Click">
                                <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                      Fill="#A1A7B8" Stretch="Uniform" Width="10" Height="10"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Queue List -->
                <Grid x:Name="BodyPanel" Grid.Row="1" Margin="10,10,10,6">
                    <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.55">
                        <Path Data="M19,3H14.82C14.4,1.84 13.3,1 12,1C10.7,1 9.6,1.84 9.18,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M12,3A1,1 0 0,1 13,4A1,1 0 0,1 12,5A1,1 0 0,1 11,4A1,1 0 0,1 12,3Z"
                              Fill="#8E96AB" Stretch="Uniform" Width="28" Height="28" Margin="0,0,0,8"/>
                        <TextBlock Text="Queue is empty" Foreground="#CBD2E1" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <ListBox x:Name="QueueList"
                             Background="Transparent"
                             BorderThickness="0"
                             AllowDrop="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ItemContainerStyle="{StaticResource CleanListItem}"
                             SelectionChanged="QueueList_SelectionChanged"
                             MouseDoubleClick="QueueList_MouseDoubleClick"
                             PreviewMouseLeftButtonDown="QueueList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="QueueList_PreviewMouseMove"
                             DragOver="QueueList_DragOver"
                             Drop="QueueList_Drop">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="CardBorder"
                                        CornerRadius="10"
                                        Background="#14FFFFFF"
                                        BorderBrush="#1AFFFFFF"
                                        BorderThickness="1"
                                        Padding="10,9,8,9"
                                        Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock x:Name="NumText"
                                                   Grid.Column="0"
                                                   Text="{Binding IndexLabel}"
                                                   Foreground="#8891A8"
                                                   FontFamily="Segoe UI"
                                                   FontSize="11.5"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,9,0"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Preview}"
                                                   Foreground="#EEF1F8"
                                                   FontFamily="Segoe UI"
                                                   FontSize="12.5"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                            <Border x:Name="NextBadge"
                                                    Background="#3B82F6"
                                                    CornerRadius="5"
                                                    Padding="6,2"
                                                    Margin="0,0,2,0"
                                                    Visibility="Collapsed"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="NEXT" Foreground="#FFFFFF" FontFamily="Segoe UI" FontSize="9.5" FontWeight="Bold"/>
                                            </Border>

                                            <StackPanel x:Name="HoverActions" Orientation="Horizontal" Visibility="Collapsed">
                                                <Button Style="{StaticResource CardActionBtn}" Click="CardEdit_Click" ToolTip="Edit">
                                                    <Path Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          Stretch="Uniform" Width="11" Height="11"/>
                                                </Button>
                                                <Button Style="{StaticResource CardActionBtn}" Click="CardDelete_Click" ToolTip="Delete">
                                                    <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                                          Fill="#F87171"
                                                          Stretch="Uniform" Width="11" Height="11"/>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <DataTemplate.Triggers>
                                    <Trigger SourceName="CardBorder" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CardBorder" Property="Background" Value="#20FFFFFF"/>
                                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="#34FFFFFF"/>
                                        <Setter TargetName="HoverActions" Property="Visibility" Value="Visible"/>
                                    </Trigger>

                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter TargetName="CardBorder" Property="Background" Value="#2A3B82F6"/>
                                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="#993B82F6"/>
                                        <Setter TargetName="NumText" Property="Foreground" Value="#93C5FD"/>
                                        <Setter TargetName="NextBadge" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- Inline Edit / Add Drawer -->
                <Border x:Name="EditDrawer"
                        Grid.Row="2"
                        Background="#1AFFFFFF"
                        BorderBrush="#24FFFFFF"
                        BorderThickness="0,1,0,0"
                        Padding="10"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBox x:Name="TxtEdit"
                                 Height="68"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="#CC0E101A"
                                 Foreground="#F3F5FA"
                                 CaretBrush="#60A5FA"
                                 BorderBrush="#33FFFFFF"
                                 BorderThickness="1"
                                 Padding="8,6"
                                 FontFamily="Segoe UI"
                                 FontSize="12.5"
                                 PreviewKeyDown="TxtEdit_PreviewKeyDown"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button x:Name="BtnCancelEdit" Content="Cancel" Style="{StaticResource FooterBtn}" Height="26" Padding="10,0" Margin="0,0,6,0" Click="BtnCancelEdit_Click"/>
                            <Button x:Name="BtnSaveEdit" Content="Save" Style="{StaticResource AccentBtn}" Height="26" Padding="14,0" Click="BtnSaveEdit_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Footer -->
                <Border x:Name="FooterBar"
                        Grid.Row="3"
                        Background="#0BFFFFFF"
                        CornerRadius="0,0,14,14"
                        BorderBrush="#14FFFFFF"
                        BorderThickness="0,1,0,0"
                        Padding="10,8,10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BtnAdd" Grid.Column="0" Content="+ Add" Style="{StaticResource FooterBtn}" Margin="0,0,6,0" Click="BtnAdd_Click"/>
                        <Button x:Name="BtnClear" Grid.Column="1" Content="Clear" Style="{StaticResource FooterBtn}" Foreground="#9CA3B8" Click="BtnClear_Click"/>
                        <Button x:Name="BtnNext" Grid.Column="3" Content="Next  &#x2192;" Style="{StaticResource AccentBtn}" Padding="16,0" Click="BtnNext_Click"/>
                    </Grid>
                </Border>

                <!-- Bottom-Right Visual Grip -->
                <Path x:Name="ResizeGripVisual"
                      Grid.Row="3"
                      Data="M 10,2 L 2,10 M 10,6 L 6,10"
                      Stroke="#48FFFFFF"
                      StrokeThickness="1.3"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Width="11" Height="11"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="0,0,5,5"
                      IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- 8-Directional Edge & Corner Resize Handles -->
        <Grid Margin="10">
            <Thumb x:Name="ResizeLeft"        Style="{StaticResource EdgeResizeThumb}" Width="7"  HorizontalAlignment="Left"   VerticalAlignment="Stretch" Margin="0,10,0,10" Cursor="SizeWE"   DragDelta="ResizeLeft_DragDelta"/>
            <Thumb x:Name="ResizeRight"       Style="{StaticResource EdgeResizeThumb}" Width="7"  HorizontalAlignment="Right"  VerticalAlignment="Stretch" Margin="0,10,0,10" Cursor="SizeWE"   DragDelta="ResizeRight_DragDelta"/>
            <Thumb x:Name="ResizeTop"         Style="{StaticResource EdgeResizeThumb}" Height="7" HorizontalAlignment="Stretch" VerticalAlignment="Top"    Margin="10,0,10,0" Cursor="SizeNS"   DragDelta="ResizeTop_DragDelta"/>
            <Thumb x:Name="ResizeBottom"      Style="{StaticResource EdgeResizeThumb}" Height="7" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="10,0,10,0" Cursor="SizeNS"   DragDelta="ResizeBottom_DragDelta"/>

            <Thumb x:Name="ResizeTopLeft"     Style="{StaticResource EdgeResizeThumb}" Width="12" Height="12" HorizontalAlignment="Left"  VerticalAlignment="Top"    Cursor="SizeNWSE" DragDelta="ResizeTopLeft_DragDelta"/>
            <Thumb x:Name="ResizeTopRight"    Style="{StaticResource EdgeResizeThumb}" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top"    Cursor="SizeNESW" DragDelta="ResizeTopRight_DragDelta"/>
            <Thumb x:Name="ResizeBottomLeft"  Style="{StaticResource EdgeResizeThumb}" Width="12" Height="12" HorizontalAlignment="Left"  VerticalAlignment="Bottom" Cursor="SizeNESW" DragDelta="ResizeBottomLeft_DragDelta"/>
            <Thumb x:Name="ResizeBottomRight" Style="{StaticResource EdgeResizeThumb}" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragDelta="ResizeBottomRight_DragDelta"/>
        </Grid>
    </Grid>
</Window>
